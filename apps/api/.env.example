# The API process does not read packages/db/.env — set this in your shell,
# your process manager, or pass it with `node --env-file`.
DATABASE_URL="postgresql://kase:password@localhost:5432/kase?schema=public"

# Redis (docker-compose service `redis`)
KASE_REDIS_HOST=localhost
KASE_REDIS_PORT=6379

# Object storage (docker-compose service `minio`)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kase-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Local development envelope-encryption key: exactly 32 random bytes encoded
# as base64/base64url. Production replaces the local provider with cloud KMS.
# Generate once and keep it out of git; rotating this value directly makes
# existing secret versions undecryptable.
# KASE_LOCAL_KEK=

# Concurrency overrides — defaults come from docs/02-stack §7
# KASE_MAX_CONCURRENT_AUDITS=2
# KASE_MAX_JOBS_PER_AUDIT=4

# RS256 public key Next.js signs session JWTs with (02-stack §5, 20-adr ADR-013).
# The API verifies with this; it never holds the matching private key, which
# lives only in the Next.js deployment. PEM, with literal "\n" for newlines
# if your env store can't hold a multi-line value:
# KASE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBg...\n-----END PUBLIC KEY-----"
