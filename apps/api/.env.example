# The API process does not read packages/db/.env — set this in your shell,
# your process manager, or pass it with `node --env-file`.
DATABASE_URL="postgresql://kase:password@localhost:5432/kase?schema=public"

# Redis (docker-compose service `redis`)
KASE_REDIS_HOST=localhost
KASE_REDIS_PORT=6379

# Object storage (docker-compose service `minio`)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kase-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Concurrency overrides — defaults come from docs/02-stack §7
# KASE_MAX_CONCURRENT_AUDITS=2
# KASE_MAX_JOBS_PER_AUDIT=4
