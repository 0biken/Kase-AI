# The web app reads the same database as the API.
DATABASE_URL="postgresql://kase:password@localhost:5432/kase?schema=public"

# Auth.js own secret (session cookie encryption). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# RS256 keypair for the Next -> Nest session exchange (02-stack §5, ADR-013).
#
# This app holds the PRIVATE half and signs; the API holds only the PUBLIC
# half and verifies. That split is the point — a compromised API can check a
# session but never forge one. Do not put the private key in apps/api.
#
# Generate:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out kase-jwt.key
#   openssl rsa -pubout -in kase-jwt.key -out kase-jwt.pub
#
# Then set KASE_JWT_PRIVATE_KEY here and KASE_JWT_PUBLIC_KEY in apps/api.
# Literal "\n" is accepted for env stores that cannot hold multi-line values.
# ---------------------------------------------------------------------------
KASE_JWT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# OAuth providers. Each is individually optional — a provider with no
# credentials is simply not offered on the sign-in page, rather than
# preventing the app from starting.
# ---------------------------------------------------------------------------

# GitHub: an OAuth App. Callback URL http://localhost:3000/api/auth/callback/github
# Login scopes only (read:user, user:email) — repository access is a separate
# credential and is deliberately NOT requested at sign-in.
KASE_GITHUB_CLIENT_ID=
KASE_GITHUB_CLIENT_SECRET=

# Google: a Google Cloud OAuth 2.0 Client ID (Web application).
# Authorized redirect URI http://localhost:3000/api/auth/callback/google
KASE_GOOGLE_CLIENT_ID=
KASE_GOOGLE_CLIENT_SECRET=

# Apple: needs a PAID Apple Developer account, a Services ID, and a .p8 key.
# KASE_APPLE_CLIENT_ID is the Services ID (e.g. com.example.kase.web).
# KASE_APPLE_CLIENT_SECRET is NOT a static secret — it is a JWT you sign with
# the .p8 key, valid for at most 6 months, so it needs a rotation owner.
# Apple also rejects http://localhost redirect URIs; local testing needs an
# HTTPS tunnel. Leave blank to run without Apple sign-in.
KASE_APPLE_CLIENT_ID=
KASE_APPLE_CLIENT_SECRET=

# Public-site intake form. Point production at a secure internal webhook that
# owns waitlist, product-request, and security-report triage. The browser never
# sees this value. For local UI verification only, use:
#   http://127.0.0.1:3000/api/intake/dev-sink
# The development sink discards payloads and is unavailable in production.
KASE_INTAKE_WEBHOOK_URL=
