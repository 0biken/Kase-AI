{
  "name": "@kase/correlation-spike",
  "version": "0.0.0",
  "private": true,
  "description": "Proves the Kase correlation path end to end: black-box IDOR -> route -> source symbol -> white-box finding -> one correlated finding.",
  "type": "commonjs",
  "scripts": {
    "spike": "tsx src/spike.ts",
    "spike:unverified": "tsx src/spike.ts --no-commit",
    "spike:fixed": "tsx src/spike.ts --fixed"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
