datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id                  String   @id
  organizationId      String
  name                String
  slug                String   @unique
  defaultGatePolicyId String
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  organization      Organization      @relation(fields: [organizationId], references: [id])
  gatePolicies      GatePolicy[]
  apiTokens         ApiToken[]
  members           ProjectMember[]
  repositories      Repository[]
  targets           Target[]
  scopePolicies     ScopePolicy[]
  audits            Audit[]
  endpointInventories EndpointInventory[]
  findingIdentities FindingIdentity[]
  waivers           Waiver[]
  suppressions      Suppression[]
  secrets           Secret[]
  evidenceRetentionOverride ProjectEvidenceRetentionOverride?
  aiConfiguration    ProjectAiConfiguration?
  testIdentities     TestIdentity[]
}

model Repository {
  id            String  @id
  projectId     String
  provider      String // 'github'
  url           String
  defaultBranch String
  credentialId  String?

  project    Project @relation(fields: [projectId], references: [id])
  credential Secret? @relation("RepositoryCredential", fields: [credentialId, projectId], references: [id, projectId], onDelete: Restrict)
  audits     Audit[]

  @@index([projectId])
  @@index([credentialId, projectId])
}

model Target {
  id               String  @id
  projectId        String
  name             String // "staging", "prod"
  baseUrl          String
  environment      String // 'production' | 'staging' | 'beta' | 'local'
  authMode         String // 'none' | 'header' | 'cookie' | 'oauth' | 'form'
  authCredentialId String?
  buildInfoUrl     String?

  project        Project @relation(fields: [projectId], references: [id])
  authCredential Secret? @relation("TargetCredential", fields: [authCredentialId, projectId], references: [id, projectId], onDelete: Restrict)
  audits         Audit[]
  endpointInventories EndpointInventory[]
  testIdentities     TestIdentity[]

  @@index([projectId])
  @@index([authCredentialId, projectId])
}

model ScopePolicy {
  id                      String   @id
  projectId               String
  allowedHosts            String[]
  deniedPaths             String[]
  maxRequestsPerSecond    Int
  maxRequestsPerAudit     Int
  destructiveAllowed      Boolean  @default(false)
  authorizationAttestedBy String
  authorizationAttestedAt DateTime

  project Project @relation(fields: [projectId], references: [id])
}

model Audit {
  id                    String    @id
  projectId             String
  targetId              String?
  repositoryId          String?
  requestedCommitSha    String?
  idempotencyKey        String?
  mode                  String // 'full' | 'smoke' | 'security' | 'regression'
  status                String // 'queued' | 'running' | 'completed' | 'partial' | 'failed' | 'cancelled'
  degraded              Boolean   @default(false)
  degradationReasons    String[]
  requestedCategories   String[]
  executedCategories    String[]
  notExecutedCategories Json // { category: string, reason: string }[]
  buildProvenanceId     String?
  cancellationRequestedAt DateTime? @db.Timestamptz(3)
  startedAt             DateTime  @default(now()) @db.Timestamptz(3)
  completedAt           DateTime? @db.Timestamptz(3)

  project         Project          @relation(fields: [projectId], references: [id])
  target          Target?          @relation(fields: [targetId], references: [id], onDelete: Restrict)
  repository      Repository?      @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  buildProvenance BuildProvenance? @relation("SelectedBuildProvenance", fields: [buildProvenanceId], references: [id])
  provenanceRecord BuildProvenance? @relation("BuildProvenanceOwner")
  jobs            AuditJob[]
  evidence        Evidence[]
  findings        Finding[]
  correlations    Correlation[]
  passingChecks   PassingCheck[]
  gateEvaluations GateEvaluation[]
  events          AuditEvent[]
  endpointInventory EndpointInventory?
  reconRequestBudget ReconRequestBudget?
  reconRequestReservations ReconRequestReservation[]
  aiSnapshot         AuditAiSnapshot?
  aiBudget           AuditAiBudget?
  aiUsage            AiUsage[]
  aiBudgetReservations AiBudgetReservation[]
  agentRuns          AgentRun[]
  coverageResults    AgentCoverageResult[]
  codeMap            CodeMap?

  @@unique([projectId, idempotencyKey])
  @@index([projectId, startedAt])
  @@index([targetId])
  @@index([repositoryId])
}

model BuildProvenance {
  id                String   @id
  auditId           String   @unique
  commitSha         String?
  branch            String?
  buildId           String?
  source            String // 'ci_supplied' | 'build_info_endpoint' | 'response_header' | 'assumed'
  verified          Boolean
  targetFingerprint String
  resolvedAt        DateTime @default(now())

  audit  Audit   @relation("BuildProvenanceOwner", fields: [auditId], references: [id], onDelete: Cascade)
  audits Audit[] @relation("SelectedBuildProvenance")
}

model AuditJob {
  id         String    @id
  auditId    String
  kind       String // 'recon' | 'blackbox_agent' | 'whitebox_agent' | 'tool' | 'correlate' | 'report'
  category   String?
  status     String // 'queued' | 'running' | 'succeeded' | 'failed' | 'skipped' | 'timed_out'
  dependsOn  String[]
  attempts   Int       @default(0)
  timeoutMs  Int
  maxRetries Int       @default(2)
  required   Boolean   @default(true)
  parentJobId String?
  continuations Int    @default(0)
  enqueuedAt DateTime? @db.Timestamptz(3)
  startedAt  DateTime? @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  heartbeatAt DateTime? @db.Timestamptz(3)
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  error      String?
  errorClass String?

  audit      Audit           @relation(fields: [auditId], references: [id])
  parentJob  AuditJob?  @relation("JobParent", fields: [parentJobId], references: [id])
  childJobs  AuditJob[] @relation("JobParent")
  executions ToolExecution[]
  reconRequestReservations ReconRequestReservation[]
  toolInvocations AgentToolInvocation[]

  @@index([auditId, status])
  @@index([leaseExpiresAt])
  @@index([parentJobId])
}

/// Ordered, durable audit progress. The sequence is allocated while the
/// corresponding Audit row is locked, making Last-Event-ID resumable.
model AuditEvent {
  id        String   @id
  auditId   String
  sequence  Int
  type      String
  data      Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, sequence])
  @@index([auditId, createdAt])
}

model ToolExecution {
  id            String   @id
  auditJobId    String
  tool          String
  toolVersion   String
  imageDigest   String
  capability    String
  argumentsHash String
  exitCode      Int?
  durationMs    Int
  requestCount  Int
  evidenceIds   String[]

  job      AuditJob   @relation(fields: [auditJobId], references: [id])
  evidence Evidence[]

  @@index([auditJobId])
}

model Evidence {
  id              String   @id
  auditId         String
  toolExecutionId String?
  tool            String
  type            String
  replayable      Boolean
  artifactUri     String?
  sha256          String
  fullRedactedSha256 String?
  sizeBytes       Int
  truncated       Boolean  @default(false)
  redacted        Boolean
  capturedAt      DateTime @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime @db.Timestamptz(3)
  objectDeletedAt DateTime? @db.Timestamptz(3)
  tombstonedAt    DateTime? @db.Timestamptz(3)
  deletionLeaseId String?
  deletionLeaseExpiresAt DateTime? @db.Timestamptz(3)
  metadata        Json

  audit           Audit             @relation(fields: [auditId], references: [id])
  toolExecution   ToolExecution?    @relation(fields: [toolExecutionId], references: [id], onDelete: SetNull)
  findingEvidence FindingEvidence[]
  agentTurns      AgentTurn[]

  @@index([auditId])
  @@index([auditId, type])
  @@index([toolExecutionId])
}

// ---------------------------------------------------------------------------
// Versioned envelope-encrypted secrets
// ---------------------------------------------------------------------------

/// Project-scoped metadata for a reusable credential. Revocation is retained
/// as a timestamp so historical references and audit events remain resolvable.
model Secret {
  id             String    @id
  projectId      String
  name           String
  kind           String
  currentVersion Int       @default(1)
  createdBy      String
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions     SecretVersion[]
  repositories Repository[]    @relation("RepositoryCredential")
  targets      Target[]        @relation("TargetCredential")
  aiConfigurations   ProjectAiConfiguration[] @relation("AiCredential")
  testIdentityCredentials TestIdentity[] @relation("TestIdentityCredential")

  @@unique([projectId, name])
  @@unique([id, projectId])
  @@index([projectId, revokedAt])
}

/// Immutable encrypted payload. A new row is inserted for every rotation;
/// ciphertext and wrapped-key material are bytea rather than encoded text.
model SecretVersion {
  id                String   @id
  secretId          String
  version           Int
  ciphertext        Bytes
  iv                Bytes
  authTag           Bytes
  wrappedDataKey    Bytes
  wrappedDataKeyIv  Bytes
  wrappedDataKeyTag Bytes
  keyProvider       String
  keyId             String
  createdBy         String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  secret Secret @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@unique([secretId, version])
  @@index([secretId, createdAt])
}

model ReconRequestBudget {
  auditId     String   @id
  maxRequests Int
  reconLimit  Int
  reserved    Int      @default(0)
  consumed    Int      @default(0)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

/// A network-request allocation belongs to one durable adapter-job stage.
/// Active reservations expire with the worker lease. Scheduler recovery charges
/// the full unknown allocation before a retry may produce more network traffic.
model ReconRequestReservation {
  id             String   @id
  auditId        String
  auditJobId     String
  stage          String
  reservedCount  Int
  consumedCount  Int      @default(0)
  status         String   @default("active") // 'active' | 'settled' | 'reclaimed'
  leaseExpiresAt DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  audit Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  job   AuditJob @relation(fields: [auditJobId], references: [id], onDelete: Cascade)

  @@unique([auditJobId, stage])
  @@index([auditId, status, leaseExpiresAt])
  @@index([auditJobId, status])
}

model EndpointInventory {
  id                  String    @id
  auditId             String    @unique
  projectId           String
  targetId            String
  previousInventoryId String?
  status              String    @default("building")
  endpointCount       Int       @default(0)
  addedCount          Int       @default(0)
  removedCount        Int       @default(0)
  changedCount        Int       @default(0)
  generatedAt         DateTime? @db.Timestamptz(3)

  audit             Audit                @relation(fields: [auditId], references: [id], onDelete: Cascade)
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  target            Target               @relation(fields: [targetId], references: [id], onDelete: Restrict)
  previousInventory EndpointInventory?   @relation("InventoryHistory", fields: [previousInventoryId], references: [id], onDelete: SetNull)
  nextInventories   EndpointInventory[]  @relation("InventoryHistory")
  endpoints         Endpoint[]
  drift             EndpointDrift[]

  @@index([projectId, targetId, generatedAt])
  @@index([previousInventoryId])
}

model Endpoint {
  id               String   @id
  inventoryId      String
  method           String
  pathTemplate     String
  parameters       Json
  rawExamples      String[]
  discoveredBy     String[]
  statusObserved   Int[]
  contentType      String?
  requiresAuth     Boolean?
  technologies     String[]
  title            String?
  server           String?
  firstSeenAuditId String
  lastSeenAuditId  String

  inventory EndpointInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, method, pathTemplate])
  @@index([inventoryId, pathTemplate])
}

model EndpointDrift {
  id               String   @id
  inventoryId      String
  endpointKey      String
  kind             String
  previousMetadata Json?
  currentMetadata  Json?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  inventory EndpointInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, endpointKey, kind])
  @@index([inventoryId, kind])
}

model CodeMap {
  id            String         @id
  auditId       String?        @unique
  projectId     String?
  repositoryId  String?
  commitSha     String?
  framework     String?        // 'nestjs' | 'fastapi'
  legacy        Boolean        @default(false)
  generatedAt   DateTime       @default(now()) @db.Timestamptz(3)

  audit         Audit?         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  routeMappings RouteMapping[]

  @@index([projectId, repositoryId, commitSha, framework])
  @@index([projectId])
}

model RouteMapping {
  id             String   @id
  codeMapId      String
  method         String
  pathTemplate   String
  framework      String // 'nestjs' | 'express' | 'fastapi' | 'django'
  handlerSymbol  String
  file           String
  line           Int
  middleware     String[]
  serviceSymbols String[]
  source         String // 'runtime_dump' | 'openapi' | 'static_parse'

  codeMap CodeMap @relation(fields: [codeMapId], references: [id], onDelete: Cascade)
}

model FindingIdentity {
  id               String  @id
  projectId        String
  fingerprint      String
  status           String // 'new' | 'open' | 'fixed' | 'verified' | 'regressed' | 'not_reproduced' | 'false_positive' | 'accepted_risk'
  firstSeenAuditId String
  lastSeenAuditId  String
  occurrences      Int
  currentSeverity  String
  waiverId         String?

  project  Project   @relation(fields: [projectId], references: [id])
  findings Finding[]

  @@unique([projectId, fingerprint])
  @@index([projectId, status, currentSeverity])
}

model Finding {
  id             String  @id
  auditId        String
  identityId     String
  origin         String // 'blackbox' | 'whitebox' | 'tool' | 'correlated'
  category       String
  ruleId         String?
  cwe            String?
  title          String
  severity       String
  severitySource String
  affectedTarget String?
  description    String
  reproduction   Json
  impact         String
  rootCause      String?
  fix            String
  fixPatch       String?
  confidenceBand String // 'high' | 'medium' | 'low'
  aiGenerated    Boolean
  gateEligible   Boolean

  audit           Audit             @relation(fields: [auditId], references: [id])
  identity        FindingIdentity   @relation(fields: [identityId], references: [id])
  sourceLocations SourceLocation[]
  findingEvidence FindingEvidence[]

  @@unique([auditId, identityId])
  @@index([auditId, category, severity])
}

model SourceLocation {
  id              String  @id
  findingId       String
  file            String
  enclosingSymbol String
  line            Int
  endLine         Int?
  commitSha       String
  verified        Boolean

  finding Finding @relation(fields: [findingId], references: [id])
}

model Correlation {
  id                     String  @id
  auditId                String
  blackboxFindingId      String
  whiteboxFindingId      String?
  endpointId             String?
  routeMappingId         String?
  method                 String // 'runtime_dump' | 'openapi' | 'static_parse' | 'request_id' | 'ai_inference'
  confidenceBand         String
  verified               Boolean
  rationale              String
  alternativesConsidered Json?

  audit Audit @relation(fields: [auditId], references: [id])
}

model PassingCheck {
  id          String   @id
  auditId     String
  category    String
  checkId     String
  target      String?
  evidenceIds String[]
  observedAt  DateTime @default(now())

  audit Audit @relation(fields: [auditId], references: [id])
}

model GateEvaluation {
  id                    String   @id
  auditId               String
  gatePolicyId          String
  gatePolicyVersion     Int
  outcome               String // 'pass' | 'fail' | 'partial'
  blockingFindingIds    String[]
  waivedFindingIds      String[]
  notExecutedCategories String[]
  commitSha             String?
  evaluatedAt           DateTime @default(now())

  audit Audit @relation(fields: [auditId], references: [id])
}

model Waiver {
  id              String   @id
  projectId       String
  fingerprint     String
  reason          String
  requestedBy     String
  approvedBy      String
  approvedAt      DateTime
  expiresAt       DateTime
  affectedRelease String?

  project Project @relation(fields: [projectId], references: [id])
}

model Suppression {
  id          String   @id
  projectId   String
  fingerprint String
  markedBy    String
  reason      String
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

// ---------------------------------------------------------------------------
// Identity and policy
//
// Project carries organizationId and defaultGatePolicyId. Without these models
// both were dangling strings with no referent, and defaultGatePolicyId was
// non-nullable — meaning no Project could be inserted without inventing an ID
// that pointed at nothing.
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  users    User[]
  projects Project[]
  invites  Invite[]
  members  OrganizationMember[]
  evidenceRetentionPolicy EvidenceRetentionPolicy?
}

model User {
  id             String   @id
  organizationId String
  email          String   @unique
  name           String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id])
  memberships  ProjectMember[]
  organizationMemberships OrganizationMember[]

  @@index([organizationId])
}

/// Organization-level authorization is deliberately distinct from project
/// roles. API tokens never receive one of these memberships.
model OrganizationMember {
  userId         String
  organizationId String
  role           String // 'member' | 'admin'
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId, role])
}

/// Organization defaults. Database checks in the M2 migration enforce the
/// inclusive 1..365 range for every independently configurable class.
model EvidenceRetentionPolicy {
  organizationId            String   @id
  replayableEvidenceDays     Int      @default(90)
  nonReplayableEvidenceDays  Int      @default(30)
  rawToolOutputDays          Int      @default(30)
  agentTranscriptDays        Int      @default(30)
  updatedBy                  String
  updatedAt                  DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Nullable values restore inheritance for that evidence class. A row may
/// remain when all values are null so the policy audit trail stays explicit.
model ProjectEvidenceRetentionOverride {
  projectId                   String   @id
  replayableEvidenceDays      Int?
  nonReplayableEvidenceDays   Int?
  rawToolOutputDays           Int?
  agentTranscriptDays         Int?
  updatedBy                   String
  updatedAt                   DateTime @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model GatePolicy {
  id        String   @id
  projectId String
  version   Int      @default(1)
  name      String
  // Only evidence-class-eligible findings may block — see ADR-002.
  rules     Json
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Finding <-> Evidence join
//
// Replaces Finding.evidenceIds String[]. An array gives no referential
// integrity and cannot answer "which findings cite this evidence?" — which is
// exactly the query evidence-class gating needs.
// ---------------------------------------------------------------------------

model FindingEvidence {
  findingId  String
  evidenceId String
  role       String // 'primary' | 'supporting'

  finding  Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([findingId, evidenceId])
  @@index([evidenceId])
}

// Dedup relationships produced by the three-level matcher. POSSIBLE_MATCH
// rows are the human triage queue and must not auto-resolve.
model FindingRelation {
  id             String   @id
  fromFindingId  String
  toFindingId    String
  kind           String // 'match' | 'possible_match' | 'correlated_with'
  confidenceBand String?
  createdAt      DateTime @default(now())

  @@unique([fromFindingId, toFindingId, kind])
  @@index([toFindingId])
}

// ---------------------------------------------------------------------------
// Credentials, membership, and audit trail
//
// None of these appear in 03-data-model, but all three are load-bearing for
// 14-api §2 and 17-security §9. Adding them here and to the doc together.
// ---------------------------------------------------------------------------

/// A long-lived credential for CLI/CI, scoped to exactly one project
/// (14-api §2). The plaintext is shown once at creation and never stored.
model ApiToken {
  id            String    @id
  projectId     String
  name          String
  /// SHA-256 of the plaintext. Unique so a collision is a constraint error
  /// rather than an ambiguous lookup.
  tokenHash     String    @unique
  /// Leading chars of the plaintext, for listing tokens without revealing
  /// them. Display only — never used for lookup.
  displayPrefix String
  role          String // 'viewer' | 'operator' | 'approver' | 'admin'
  createdBy     String
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  /// Revocation is a timestamp, not a row delete: audit-trail entries
  /// referencing this token must keep resolving (17-security §9).
  revokedAt     DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Per-project role for a session user.
///
/// 14-api §2 puts the role on the *token*, which leaves browser users with no
/// derivable per-project role — User has no project link at all. This closes
/// that gap so ProjectScopeGuard can authorize both credential types.
model ProjectMember {
  userId    String
  projectId String
  role      String // 'viewer' | 'operator' | 'approver' | 'admin'
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

/// Append-only audit trail (17-security §9): authn/authz decisions, project
/// and policy changes with diffs, scope denials, evidence access, secret
/// lifecycle. Retained indefinitely — there is no delete path by design.
model AuditTrailEvent {
  id           String   @id
  /// Nullable: a failed authentication has no project yet, but must still be
  /// recorded.
  projectId    String?
  actorType    String // 'user' | 'token' | 'system'
  actorId      String?
  action       String // e.g. 'project.update', 'auth.denied', 'scope.denied'
  resourceType String?
  resourceId   String?
  /// Before/after for mutations. §9 requires policy changes carry diffs.
  diff         Json?
  metadata     Json?
  outcome      String // 'allowed' | 'denied' | 'error'
  createdAt    DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([action, createdAt])
}

/// An invitation to join an Organization. ADR-013: an OAuth identity by
/// itself never grants access — a successful handshake with Google, GitHub
/// or Apple proves who someone is, not that they are allowed in. Sign-in
/// requires a pending invite matching the provider's *verified* email.
model Invite {
  id             String    @id
  email          String
  organizationId String
  /// Role granted on acceptance, for projects listed in `projectIds`.
  role           String // 'viewer' | 'operator' | 'approver' | 'admin'
  /// Projects the invitee is enrolled into on acceptance. Empty is valid:
  /// an org member with no project access yet.
  projectIds     String[]
  invitedBy      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  /// Set when accepted, so the trail links invite -> the User it created.
  acceptedUserId String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// One live invite per email per org. Re-inviting an existing address
  /// updates that row rather than racing two acceptances.
  @@unique([email, organizationId])
  @@index([email])
}

// ---------------------------------------------------------------------------
// M4 — AI Provider, Agent Runtime, and Budget
// ---------------------------------------------------------------------------

model ModelCatalogEntry {
  id                   String    @id
  provider             String    // 'anthropic' | 'openai'
  modelId              String    // exact: 'claude-sonnet-4-20250514'
  catalogRevision      Int
  displayName          String
  contextLimit         Int
  outputLimit          Int
  capabilities         String[]  // ['tool_use', 'streaming', 'prompt_caching']
  inputPricePerMToken  Decimal?  @db.Decimal(10,6)
  outputPricePerMToken Decimal?  @db.Decimal(10,6)
  cachedPricePerMToken Decimal?  @db.Decimal(10,6)
  status               String    @default("available") // 'available' | 'deprecated' | 'retired'
  retiredAt            DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([provider, modelId, catalogRevision])
  @@index([provider, status])
}

model ProjectAiConfiguration {
  projectId            String   @id
  provider             String
  modelId              String
  catalogRevision      Int
  credentialMode       String   // 'project_secret' | 'platform'
  credentialSecretId   String?
  budgetTotalTokens    Int      @default(2000000)
  budgetMaxCalls       Int      @default(120)
  budgetMaxContextBytes Int     @default(400000)
  budgetMaxOutputTokens Int     @default(16000)
  budgetBlackboxTokens Int      @default(900000)
  budgetBlackboxCalls  Int      @default(54)
  budgetWhiteboxTokens Int      @default(700000)
  budgetWhiteboxCalls  Int      @default(42)
  updatedBy            String
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  project              Project  @relation(fields: [projectId], references: [id])
  credentialSecret     Secret?  @relation("AiCredential", fields: [credentialSecretId, projectId], references: [id, projectId])

  @@index([provider, modelId])
}

model TestIdentity {
  id                   String   @id
  projectId            String
  targetId             String
  label                String   // 'alice' | 'bob'
  credentialSecretId   String
  active               Boolean  @default(true)
  createdBy            String
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  project              Project  @relation(fields: [projectId], references: [id])
  target               Target   @relation(fields: [targetId], references: [id])
  credentialSecret     Secret   @relation("TestIdentityCredential", fields: [credentialSecretId, projectId], references: [id, projectId])

  @@index([projectId, targetId, active])
}

model AuditAiSnapshot {
  auditId              String   @id
  provider             String
  modelId              String
  catalogRevision      Int
  modelContextLimit    Int
  modelOutputLimit     Int
  credentialMode       String
  credentialSecretId   String?
  credentialSecretVersion Int?
  promptVersion        String
  methodologyDigest    String
  budgetTotalTokens    Int
  budgetMaxCalls       Int
  budgetMaxContextBytes Int
  budgetMaxOutputTokens Int
  budgetBlackboxTokens Int
  budgetBlackboxCalls  Int
  budgetWhiteboxTokens Int
  budgetWhiteboxCalls  Int
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  audit                Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

model AuditAiBudget {
  auditId              String   @id
  totalTokensLimit     Int
  totalCallsLimit      Int
  contextBytesLimit    Int
  totalTokensConsumed  Int      @default(0)
  totalCallsConsumed   Int      @default(0)
  contextBytesConsumed Int      @default(0)
  totalTokensReserved  Int      @default(0)
  totalCallsReserved   Int      @default(0)
  bbTokensConsumed     Int      @default(0)
  bbCallsConsumed      Int      @default(0)
  bbTokensReserved     Int      @default(0)
  bbCallsReserved      Int      @default(0)
  wbTokensConsumed     Int      @default(0)
  wbCallsConsumed      Int      @default(0)
  wbTokensReserved     Int      @default(0)
  wbCallsReserved      Int      @default(0)
  degradationState     String   @default("green") // 'green' | 'yellow' | 'red' | 'exceeded'
  degradedAt           DateTime? @db.Timestamptz(3)
  deadlineAt           DateTime? @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  audit                Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

model AiBudgetReservation {
  id                   String    @id
  auditId              String
  audit                Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  agentRole            String    // 'blackbox' | 'whitebox'
  turnSequence         Int
  callId               String
  estimatedInput       Int
  maxOutput            Int
  contextBytes         Int       @default(0)
  status               String    @default("active") // 'active' | 'settled' | 'expired'
  settledInput         Int?
  settledOutput        Int?
  settledCached        Int?
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  settledAt            DateTime? @db.Timestamptz(3)

  @@unique([auditId, agentRole, turnSequence, callId])
  @@index([auditId, status])
}

model AiUsage {
  id                   String   @id
  auditId              String
  agentRunId           String?
  providerRequestId    String?
  stage                String   // 'blackbox' | 'whitebox' | 'correlation' | 'review' | 'report'
  provider             String
  model                String
  inputTokens          Int
  outputTokens         Int
  cachedTokens         Int      @default(0)
  latencyMs            Int
  retries              Int      @default(0)
  outcome              String   // 'success' | 'refusal' | 'error' | 'timeout' | 'cancelled' | 'budget_exhausted'
  costUsd              Decimal? @db.Decimal(10,6)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  audit                Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId, stage])
}

model AgentRun {
  id                   String    @id
  auditId              String
  auditJobId           String
  role                 String    // 'blackbox' | 'whitebox'
  status               String    // 'running' | 'waiting_for_tool' | 'completed' | 'failed' | 'cancelled' | 'budget_exhausted'
  currentTurn          Int       @default(0)
  nextTurnSequence     Int       @default(0)
  nextCallSequence     Int       @default(0)
  currentTranscriptId  String?
  promptVersion        String
  terminalSummary      String?
  waitingForJobId      String?
  deadline             DateTime? @db.Timestamptz(3)
  startedAt            DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt           DateTime? @db.Timestamptz(3)

  audit                Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  turns                AgentTurn[]
  toolInvocations      AgentToolInvocation[]

  @@unique([auditId, role])
  @@index([auditJobId])
}

model AgentTurn {
  id                   String   @id
  agentRunId           String
  turnSequence         Int
  role                 String   // 'assistant' | 'tool_result'
  transcriptEvidenceId String?
  inputTokens          Int?
  outputTokens         Int?
  cachedTokens         Int?
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  agentRun             AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  transcriptEvidence   Evidence? @relation(fields: [transcriptEvidenceId], references: [id], onDelete: SetNull)

  @@unique([agentRunId, turnSequence])
}

model AgentToolInvocation {
  id                   String    @id
  agentRunId           String
  turnSequence         Int
  callId               String
  capability           String
  arguments            Json
  argumentsValid       Boolean
  validationErrors     String[]
  status               String    // 'pending' | 'dispatched' | 'completed' | 'failed' | 'cancelled'
  childJobId           String?
  resultEvidenceIds    String[]
  providerCallId       String?
  result               Json?
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  completedAt          DateTime? @db.Timestamptz(3)

  agentRun             AgentRun  @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  childJob             AuditJob? @relation(fields: [childJobId], references: [id], onDelete: SetNull)

  @@unique([agentRunId, turnSequence, callId])
  @@index([childJobId])
}

model AgentCoverageResult {
  id                   String   @id
  auditId              String
  agentRole            String   // 'blackbox' | 'whitebox'
  category             String
  outcome              String   // 'passed' | 'finding' | 'blocked'
  blockedReason        String?  // 'tool_unavailable' | 'target_unreachable' | 'auth_failed' | 'out_of_scope' | 'budget_exhausted' | 'destructive_not_authorized'
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  audit                Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, agentRole, category])
}
